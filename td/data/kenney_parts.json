  "enemies": {
    "_설명": "적 6종(2026-09-06 캐릭터 팩으로 전부 다른 모델 — 사장님 '몹이 다 똑같아'). model=뼈대 애니메이션이 든 창고 캐릭터 · tint=부위 이름별 곱하는 색('*' 전체) · scale=enemyScale 에 또 곱함 · anim=쓸 클립(walk|run|sprint) · animSpeed=클립 배속 · motion=코드 동작(hop 종종걸음 / sway 무겁게 / hover 떠서 흔들림 / stomp 쿵쿵) · aura=발밑 빛 색",
    "basic":  { "model": "mini-dungeon/character-orc", "tint": { "*": "#FFFFFF" }, "scale": 1.5, "anim": "walk", "animSpeed": 1.3, "motion": "none", "aura": "#7CE76A" },
    "fast":   { "model": "cube-pets/animal-fox", "tint": { "*": "#FFFFFF" }, "scale": 0.62, "anim": "run", "animSpeed": 1.7, "motion": "dash", "aura": "#FFA030" },
    "tank":   { "model": "cube-pets/animal-elephant", "tint": { "*": "#FFFFFF" }, "scale": 0.95, "anim": "walk", "animSpeed": 0.75, "motion": "stomp", "aura": "#8FA0B0" },
    "swarm":  { "model": "cube-pets/animal-chick", "tint": { "*": "#FFFFFF" }, "scale": 0.5, "anim": "run", "animSpeed": 2.4, "motion": "hop", "aura": "#FFE040" },
    "flyer":  { "model": "cube-pets/animal-parrot", "tint": { "*": "#FFFFFF" }, "scale": 0.56, "anim": "run", "animSpeed": 1.4, "motion": "hover", "aura": "#E86060" },
    "boss":   { "model": "cube-pets/animal-lion", "tint": { "*": "#FFA090", "body": "#FF9A88" }, "scale": 1.85, "anim": "walk", "animSpeed": 0.85, "motion": "stomp", "aura": "#FF3030" }
  },
